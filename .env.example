# Nebius Token Factory (OpenAI-compatible). Get a key at https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Any Nemotron id from GET $NEBIUS_BASE_URL/models that supports tool calling
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Optional: enables live web search for upgrades and FIA news (https://tavily.com)
TAVILY_API_KEY=

# Showroom car: a licensed 3D model, painted in each team's livery; taking the
# car apart uses the code-built car. The model is not in this repo. Locally put
# it at public/models/cars/f1-2026.glb (git-ignored); on a deployed site host
# it privately and set its URL here. See public/models/README.md.
# NEXT_PUBLIC_CAR_MODEL_URL=https://…/f1-2026.glb
# Set to 0 to always use the code-built car:
# NEXT_PUBLIC_CAR_MODEL=0

# Lena's voice is fixed in lib/server/tts.ts (en-GB-LibbyNeural) — no env override.
