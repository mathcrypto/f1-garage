# Nebius Token Factory (OpenAI-compatible). Get a key at https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Any Nemotron id from GET $NEBIUS_BASE_URL/models that supports tool calling
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Optional: enables live web search for upgrades and FIA news (https://tavily.com)
TAVILY_API_KEY=

# Optional: a natural British voice for Lena. Set ONE of these.
# Azure Speech (free tier: 500k characters/month). Create a Speech resource in the Azure portal.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=uksouth
# Natural en-GB female voices: en-GB-SoniaNeural (default), en-GB-LibbyNeural, en-GB-MaisieNeural, en-GB-AbbiNeural
AZURE_SPEECH_VOICE=en-GB-SoniaNeural
# ElevenLabs: pick a British female voice in their Voice Library and paste its id.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
