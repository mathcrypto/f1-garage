# Nebius Token Factory (OpenAI-compatible). Get a key at https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Any Nemotron id from GET $NEBIUS_BASE_URL/models that supports tool calling
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Optional: enables live web search for upgrades and FIA news (https://tavily.com)
TAVILY_API_KEY=

# Optional: Hunyuan3D / TRELLIS .glb from public/models/cars/ (default off — procedural is sharper)
# One base.glb covers all teams via livery; fused meshes auto-partition for Explore/dismantle.
# Generate: https://huggingface.co/spaces/tencent/Hunyuan3D-2.1  (see public/models/cars/refs/UPLOAD.md)
# NEXT_PUBLIC_AI_CAR=1

# Lena's voice is fixed in lib/server/tts.ts (en-GB-LibbyNeural) — no env override.
NEXT_PUBLIC_AI_CAR=
